# =============================================================================
# MetrologyEye — SIH 2026
# .gitignore — what NEVER enters version control
# =============================================================================

# ---------------------------------------------------------------------------
# SECRETS (most important rule — kept first so it is impossible to miss)
# ---------------------------------------------------------------------------
.env
*.env.local
*.env.production
.env.*.local

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
wheels/
sdist/
develop-eggs/
lib/
lib64/
parts/
var/
.installed.cfg
MANIFEST

# Virtual environments — never commit these; team members create their own
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test / coverage artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc
nosetests.xml
test-results/
.tox/
.nox/

# Type checker
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
pyrightconfig.json

# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Node / Frontend (for when the Next.js frontend is added)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo

# ---------------------------------------------------------------------------
# IDE & OS noise
# ---------------------------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store
Desktop.ini

# ---------------------------------------------------------------------------
# Build artefacts & generated files
# ---------------------------------------------------------------------------
*.log
*.pid
*.seed
*.pid.lock
*.gz
*.zip
*.tar
*.rar
report[0-9]*.html

# PDF evidence crops and generated notices (runtime output, not source)
MundeApp/backend/.artifacts/

# ---------------------------------------------------------------------------
# Claude / MCP tooling  (local dev convenience, not project code)
# ---------------------------------------------------------------------------
# .mcp.json  ← intentionally NOT ignored: it defines which MCP servers to run
#              and uses ${SUPABASE_ACCESS_TOKEN} substitution, so no real secret
#              is stored in the file. Teammates need this to use the same tools.
# .agents/   ← Claude agent configs, personal to this machine, not needed by others
.agents/
# .claude/   ← contains editor state and personal conversation history
.claude/

# skills-lock.json — Claude skills manifest; safe to commit, not required
