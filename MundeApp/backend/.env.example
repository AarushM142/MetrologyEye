# =============================================================================
# MetrologyEye — Backend Configuration Template
# =============================================================================
# HOW TO USE:
#   1. Copy this file: `cp .env.example .env`
#   2. Fill in the values marked REQUIRED.
#   3. NEVER commit .env — it is in .gitignore.
#
# Variables with a default shown work out-of-the-box without editing.
# The backend starts cleanly even with GEMINI_API_KEY empty; it runs in
# "mocked" mode (fixture extractor) and marks every response degraded.
# =============================================================================


# -----------------------------------------------------------------------------
# GEMINI (AI extraction / verification)
# -----------------------------------------------------------------------------

# REQUIRED for real label analysis (Gemini 1.5 Flash or later).
# Get one at https://aistudio.google.com/app/apikey → "Create API Key".
# Leave empty to run fully offline: the fixture extractor fires instead and
# every response carries degraded=["extract_mocked"].
GEMINI_API_KEY=

# Which Gemini model to use. Changing this never requires a code change.
# Options (as of 2026): gemini-1.5-flash  |  gemini-1.5-pro  |  gemini-2.0-flash-exp
# gemini-1.5-flash is the best latency/cost trade-off for the <3 s NFR.
GEMINI_MODEL=gemini-1.5-flash

# Per-request timeout in seconds for the Gemini REST call.
# This is the first lever to pull if the end-to-end latency NFR is breached.
GEMINI_TIMEOUT_S=20.0


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Origin of the frontend dev server. Must match exactly (including scheme).
# Default works when Next.js runs on its default port 3000.
CORS_ORIGIN=http://localhost:3000

# Maximum size of an uploaded image file, in megabytes.
MAX_UPLOAD_MB=12

# How long a completed analysis stays in the in-memory store (seconds).
# After this, GET /api/analysis/{id} returns 404.  3600 = 1 hour.
ANALYSIS_TTL_SECONDS=3600

# Longest image edge before the image is sent to Gemini.
# Lower values reduce Gemini latency but may hurt OCR accuracy on fine print.
# Reduce to 1200 if the <3 s NFR is not met; increase to 2048 for better detail.
MAX_IMAGE_EDGE_PX=1600


# -----------------------------------------------------------------------------
# STATUTORY CONSTANTS (change only if ISO/IEC 15420 is amended)
# -----------------------------------------------------------------------------

# EAN-13 nominal symbol width at 100% print magnification (ISO/IEC 15420).
# Used by the scale service to convert px → mm for font-height checks.
# Do not change this unless you know what you are doing.
EAN13_NOMINAL_WIDTH_MM=37.29


# -----------------------------------------------------------------------------
# SUPABASE (optional — future database persistence)
# -----------------------------------------------------------------------------
# The backend currently uses an in-memory TTL store (see app/store.py).
# Supabase is pre-wired; migrating is a one-file change in store.py.
# Leave blank unless you have set up the Supabase project.
#
# Project: https://supabase.com/dashboard/project/jmjabfbgsgttkehzmopu
# SUPABASE_URL=https://jmjabfbgsgttkehzmopu.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=      ← NEVER expose this on the client side
